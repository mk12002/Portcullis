      "tool": {
        "driver": {
          "informationUri": "https://github.com/portcullis-scanner/portcullis",
          "name": "portcullis",
          "rules": [
            {
              "fullDescription": {
                "text": "A pipeline file that could not be parsed. A malformed workflow is itself a (LOW) finding: it may silently not run, and it hides from analysis."
              },
              "help": {
                "text": "A pipeline file that could not be parsed. A malformed workflow is itself a (LOW) finding: it may silently not run, and it hides from analysis.\n\nFalse-positive note: Non-pipeline files matching pipeline names (e.g. templates) can trip this."
              },
              "id": "R0",
              "name": "Unparseablepipelinefile",
              "shortDescription": {
                "text": "Unparseable pipeline file"
              }
            },
            {
              "fullDescription": {
                "text": "Privileged workflows processing attacker-controllable input: pull_request_target/workflow_run checking out PR-head code (pwn-request), artifact downloads from untrusted runs (artifact poisoning), checkout credential persistence on PR-driven workflows, self-hosted runners exposed to PRs, and MR-triggered pipelines touching protected credentials."
              },
              "help": {
                "text": "Privileged workflows processing attacker-controllable input: pull_request_target/workflow_run checking out PR-head code (pwn-request), artifact downloads from untrusted runs (artifact poisoning), checkout credential persistence on PR-driven workflows, self-hosted runners exposed to PRs, and MR-triggered pipelines touching protected credentials.\n\nFalse-positive note: pull_request_target is legitimate for labeling/triage that never touches PR code — reachability to a checkout of PR head is what escalates. Verify the job actually uses the untrusted input."
              },
              "id": "R1",
              "name": "Dangeroustriggers",
              "shortDescription": {
                "text": "Dangerous triggers"
              }
            },
            {
              "fullDescription": {
                "text": "Attacker-controllable context (PR/issue titles and bodies, comments, head refs, commit messages, MR variables, CHANGE_* values) interpolated directly into a shell run/script line."
              },
              "help": {
                "text": "Attacker-controllable context (PR/issue titles and bodies, comments, head refs, commit messages, MR variables, CHANGE_* values) interpolated directly into a shell run/script line.\n\nFalse-positive note: Interpolating trusted context (github.sha, github.repository) is safe and not flagged. The fix is routing the value through env: and referencing it as a quoted shell variable."
              },
              "id": "R2",
              "name": "Expressioninjection",
              "shortDescription": {
                "text": "Expression injection"
              }
            },
            {
              "fullDescription": {
                "text": "Actions and container images referenced by mutable tags or branches instead of commit SHAs / digests — a supply-chain hijack vector, weighted by first- vs third-party publisher."
              },
              "help": {
                "text": "Actions and container images referenced by mutable tags or branches instead of commit SHAs / digests — a supply-chain hijack vector, weighted by first- vs third-party publisher.\n\nFalse-positive note: SHA pinning trades away automatic updates; pair it with an update bot. First-party (actions/, github/) references are lower urgency, not zero."
              },
              "id": "R3",
              "name": "Action/imagepinning",
              "shortDescription": {
                "text": "Action / image pinning"
              }
            },
            {
              "fullDescription": {
                "text": "Missing explicit permissions block (broad default on many setups), write-all grants, over-broad write scopes on the job token, and blanket secrets: inherit into reusable workflows."
              },
              "help": {
                "text": "Missing explicit permissions block (broad default on many setups), write-all grants, over-broad write scopes on the job token, and blanket secrets: inherit into reusable workflows.\n\nFalse-positive note: Some jobs legitimately need contents:write (release automation). The recommendation is an explicit least-privilege block, not removing needed scopes."
              },
              "id": "R4",
              "name": "Tokenpermissions",
              "shortDescription": {
                "text": "Token permissions"
              }
            },
            {
              "fullDescription": {
                "text": "Secrets reachable from untrusted-trigger jobs, secrets echoed to logs or passed as command-line arguments, and plaintext credential-shaped strings hardcoded in pipeline files (redacted in all output)."
              },
              "help": {
                "text": "Secrets reachable from untrusted-trigger jobs, secrets echoed to logs or passed as command-line arguments, and plaintext credential-shaped strings hardcoded in pipeline files (redacted in all output).\n\nFalse-positive note: High-entropy detection also matches hashes and opaque IDs — such findings carry LOW confidence and surface without blocking. Values are always redacted."
              },
              "id": "R5",
              "name": "Secretexposure",
              "shortDescription": {
                "text": "Secret exposure"
              }
            },
            {
              "fullDescription": {
                "text": "curl|bash-style install patterns, tool downloads without checksum verification, remote content piped into interpreters, and opting back into deprecated insecure workflow commands."
              },
              "help": {
                "text": "curl|bash-style install patterns, tool downloads without checksum verification, remote content piped into interpreters, and opting back into deprecated insecure workflow commands.\n\nFalse-positive note: Legitimate setup scripts use these patterns constantly; the remediation is pinning + checksum verification, not removal."
              },
              "id": "R6",
              "name": "Stepintegrity",
              "shortDescription": {
                "text": "Step integrity"
              }
            }
          ],
          "version": "0.1.0"
        }
      }
    }
